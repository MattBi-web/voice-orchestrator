__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.pytest_cache/
.DS_Store
# The web agent-builder's local database — a developer's own edited agent
# family, not source to commit (config/agents.yaml stays the one checked-in
# starting point; see webapi/db.py's docstring).
data/agents.db
# Append-only call log (call_log.py) — a developer's own local call
# history, not something to ship as repo content.
data/call_log.jsonl
# Node / Vite frontend (web/)
web/node_modules/
web/dist/
.env.save
# Blocco 3's webhook execution log — local history, same as call_log.jsonl.
data/webhook_log.jsonl
# Scratch folder for files the assistant moved aside instead of deleting.
_to_delete/
# Blocco 5: documents uploaded from the agent builder may be private — only
# the bundled demo files are tracked. To ship one with the repo (e.g. to
# the deployed voice worker), add it explicitly: git add -f data/knowledge/<name>
data/knowledge/*
!data/knowledge/billing_policy.md
!data/knowledge/internet_troubleshooting.md
!data/knowledge/plans_and_offers.md
!data/knowledge/tv_troubleshooting.md
