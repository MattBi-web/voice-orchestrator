# Which provider powers classify/respond/summarize: fake (default, zero setup) | anthropic | openai | gemini
VOICE_ORCH_PROVIDER=fake

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Voice layer (pip install -e ".[voice]") — only needed to run
# `python -m voice_orchestrator.voice.worker dev`. The text core and the
# whole test suite work with none of these set.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
