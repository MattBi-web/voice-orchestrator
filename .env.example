# Which provider powers classify/respond/summarize: fake (default, zero setup) | anthropic | openai | gemini
VOICE_ORCH_PROVIDER=fake

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Voice layer (pip install -e ".[voice]") — only needed to run
# `python -m voice_orchestrator.voice.worker dev`. The text core and the
# whole test suite work with none of these set.
# LIVEKIT_URL/API_KEY/API_SECRET are also what the agent-builder backend's
# "Test live (voce)" tab uses (webapi/voice_token.py) to mint room tokens —
# set these three and that tab lights up with no extra config.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# The livekit ElevenLabs plugin's own name for it, ELEVEN_API_KEY, works too.
ELEVENLABS_API_KEY=

# Self-imposed daily cap on real-time voice minutes (voice/usage_guard.py) —
# none of the three services above offer a spending cap of their own, so
# the worker refuses new calls once this many minutes have run today.
# Default: 60.
VOICE_ORCH_MAX_CALL_MINUTES_PER_DAY=

# Blocco 6 — shared mode. Unset (default): builder in data/agents.db, calls,
# logs and knowledge in files. Set to one database URL (Render's
# postgres://… works; needs pip install -e ".[webapi,postgres]") and the web
# service and the voice worker share everything through it.
VOICE_ORCH_DATABASE_URL=
